# ─── Platform Secrets (never exposed to users) ──────────────────────────────
# AES-256-GCM master key for encrypting all user/workspace secrets at rest.
# Generate with: openssl rand -hex 32
OMNIGRID_MASTER_KEY=

# ─── Deployment / Runtime ─────────────────────────────────────────────────
OMNIGRID_DB_PATH=./data/omnigrid.db
OMNIGRID_HOST=0.0.0.0
OMNIGRID_PORT=3000
OMNIGRID_PUBLIC_URL=http://localhost:3000

# ─── OAuth / Platform Login ────────────────────────────────────────────────
# GitHub OAuth app credentials.
# Callback must exactly match: ${OMNIGRID_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth app credentials.
# Callback must exactly match: ${OMNIGRID_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP credentials for passwordless email magic-link login.
# Recommended: create a dedicated Gmail sender account and use a Gmail App Password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Optional sender label/address for OmniGrid auth emails.
# Falls back to GMAIL_SMTP_USER when omitted.
AUTH_EMAIL_FROM="OmniGrid <your-gmail-address@gmail.com>"

# ─── Deprecated / moved to per-workspace settings ───────────────────────────
# TAILSCALE_API_KEY, TAILSCALE_TAILNET, NPM_*, ALERT_WEBHOOK_URL
# are now managed per user/workspace via the Settings UI.
# Remove them from env to enforce SaaS input model.

# Example local auth setup

# OMNIGRID_PUBLIC_URL=http://localhost:3000
# GITHUB_CLIENT_ID=dev_github_client_id
# GITHUB_CLIENT_SECRET=dev_github_client_secret
# GOOGLE_CLIENT_ID=dev_google_client_id
# GOOGLE_CLIENT_SECRET=dev_google_client_secret
# GMAIL_SMTP_USER=your-gmail-address@gmail.com
# GMAIL_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Example production auth setup

# OMNIGRID_PUBLIC_URL=https://omnigrid.example.com
# GITHUB_CLIENT_ID=prod_github_client_id
# GITHUB_CLIENT_SECRET=prod_github_client_secret
# GOOGLE_CLIENT_ID=prod_google_client_id
# GOOGLE_CLIENT_SECRET=prod_google_client_secret
# GMAIL_SMTP_USER=auth@your-company.example
# GMAIL_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# AUTH_EMAIL_FROM="OmniGrid <auth@your-company.example>"