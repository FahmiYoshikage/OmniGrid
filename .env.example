# ─── Platform Secrets (never exposed to users) ──────────────────────────────
# AES-256-GCM master key for encrypting all user/workspace secrets at rest.
# Generate with: openssl rand -hex 32
OMNIGRID_MASTER_KEY=

# GitHub OAuth app credentials for platform login.
# Create app at: https://github.com/settings/developers
# Authorization callback must exactly match: ${OMNIGRID_PUBLIC_URL}/api/auth/github/callback
#
# NOTE: GitHub does NOT support wildcard callback URLs.
# For SaaS with both dev + prod, create TWO separate OAuth apps:
#   - Dev app:  callback = http://localhost:3000/api/auth/github/callback
#   - Prod app: callback = https://omnigrid.crud.my.id/api/auth/github/callback
# Then use the correct CLIENT_ID / CLIENT_SECRET per environment.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Deployment / Runtime ─────────────────────────────────────────────────
OMNIGRID_DB_PATH=./data/omnigrid.db
OMNIGRID_HOST=0.0.0.0
OMNIGRID_PORT=3000
OMNIGRID_PUBLIC_URL=http://localhost:3000

# ─── Deprecated / moved to per-workspace settings ───────────────────────────
# TAILSCALE_API_KEY, TAILSCALE_TAILNET, NPM_*, ALERT_WEBHOOK_URL
# are now managed per user/workspace via the Settings UI.
# Remove them from env to enforce SaaS input model.

# Prod app → callback https://omnigrid.crud.my.id/api/auth/github/callback
# Dev app → callback http://localhost:3000/api/auth/github/callback

#OMNIGRID_PUBLIC_URL=http://localhost:3000
#GITHUB_CLIENT_ID=dev_client_id
#GITHUB_CLIENT_SECRET=dev_client_secret

#OMNIGRID_PUBLIC_URL=https://omnigrid.crud.my.id
#GITHUB_CLIENT_ID=prod_client_id
#GITHUB_CLIENT_SECRET=prod_client_secret